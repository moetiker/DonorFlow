# Build container for DonorFlow
# This creates a reproducible build environment with Linux-native binaries

# Package manifests with the version field pinned to 0.0.0. Every release
# rewrites the version in package.json; copying the manifests unchanged would
# invalidate the dependency layer below each time and force a full install.
# The real package.json still arrives with `COPY . .` before the build.
FROM node:24-slim AS manifests
WORKDIR /manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN node -e "const fs = require('fs'); \
  const j = JSON.parse(fs.readFileSync('package.json', 'utf8')); \
  j.version = '0.0.0'; \
  fs.writeFileSync('package.json', JSON.stringify(j, null, 2) + '\\n');"

FROM node:24-slim

# Install build essentials for native modules (better-sqlite3)
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# pnpm in the version package.json names (packageManager), through corepack.
RUN corepack enable

# Dependencies layer: only invalidated when the dependencies change, not on a
# version bump (see the manifests stage). The pnpm store cache mount persists
# downloads across builds, so even a cache-busting install (changed
# dependency) avoids re-downloading unchanged packages. The store is copied,
# not linked, into node_modules, because the mount is gone after this step.
COPY --from=manifests /manifests/ ./
RUN --mount=type=cache,target=/pnpm-store \
    pnpm install --frozen-lockfile --store-dir /pnpm-store --package-import-method copy

# Prisma client. The schema is copied *after* the install so schema edits do
# not invalidate the (slow) dependency layer above.
COPY prisma ./prisma/
RUN DATABASE_URL="file:./dummy.db" pnpm exec prisma generate

# Copy source files
COPY . .

# Build Next.js application (emits a self-contained server in .next/standalone
# containing only the traced runtime dependencies — see output: 'standalone').
# The .next/cache mount persists webpack's incremental build cache across builds,
# so subsequent builds only recompile what actually changed.
# next is called directly, not through `pnpm build`: pnpm 11 checks the
# installed dependencies against package.json before running a script, sees the
# real version instead of the 0.0.0 of the dependency layer, and aborts trying
# to reinstall without a TTY (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY).
RUN --mount=type=cache,target=/app/.next/cache ./node_modules/.bin/next build

# Assemble a minimal, self-contained deployable in /app/deploy-out.
# This ships only what the standalone server needs plus the Prisma schema for
# the remote `prisma db push` — a fraction of the full node_modules tree.
RUN set -eux; \
    OUT=/app/deploy-out; \
    mkdir -p "$OUT"; \
    cp -a .next/standalone/. "$OUT/"; \
    mkdir -p "$OUT/.next/static"; \
    cp -a .next/static/. "$OUT/.next/static/"; \
    if [ -d public ]; then cp -a public "$OUT/public"; fi; \
    cp -a prisma "$OUT/prisma"; \
    cp -a prisma.config.ts "$OUT/prisma.config.ts"; \
    cp -a package.json "$OUT/package.json"; \
    cp -a .mise.toml "$OUT/.mise.toml"; \
    if [ -f .env.example ]; then cp -a .env.example "$OUT/.env.example"; fi; \
    mkdir -p "$OUT/deploy"; \
    cp -a deploy/donorflow.service.example "$OUT/deploy/"; \
    rm -f "$OUT"/prisma/*.db "$OUT"/prisma/*.db-journal "$OUT"/prisma/*.db-shm "$OUT"/prisma/*.db-wal

# The deployable is now in /app/deploy-out with:
# - server.js (standalone Next.js server entrypoint)
# - .next/ (standalone build output + static assets)
# - node_modules/ (only traced runtime dependencies, Linux-native binaries)
# - prisma/ (schema, for `prisma db push` on the server)
# - public/ (static assets)
# - deploy/donorflow.service.example (systemd unit, applied on each deploy)
# - package.json
