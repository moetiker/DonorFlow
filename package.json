{
  "name": "donorflow",
  "version": "0.6.21",
  "description": "Modern donation management system for clubs and organizations",
  "keywords": [
    "donation-management",
    "fundraising",
    "nonprofit",
    "clubs",
    "associations",
    "nextjs",
    "typescript",
    "prisma",
    "sqlite",
    "react",
    "nextauth",
    "i18n",
    "self-hosted"
  ],
  "author": "Manuel Oetiker <manuel@oetiker.ch>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moetiker/DonorFlow.git"
  },
  "homepage": "https://github.com/moetiker/DonorFlow",
  "scripts": {
    "dev": "next dev -p 7526",
    "build": "next build",
    "start": "next start -p 7526",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "prisma generate && pnpm lint && pnpm typecheck",
    "test": "tsx --test test/*.test.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed-demo.ts",
    "db:migrate-orphans": "tsx prisma/migrate-orphans-to-club-pool.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-better-sqlite3": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.9",
    "next": "^16.4.6",
    "next-auth": "^4.24.13",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.1.4",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "~7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.4.0"
}
